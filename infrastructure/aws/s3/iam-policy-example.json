{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProjectFlowS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:AbortMultipartUpload"
      ],
      "Resource": ["arn:aws:s3:::projectflow-ai-storage", "arn:aws:s3:::projectflow-ai-storage/*"]
    }
  ]
}
