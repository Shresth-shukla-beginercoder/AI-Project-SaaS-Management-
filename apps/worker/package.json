{
  "name": "@projectflow/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --clean",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.8",
    "@ai-sdk/google": "^1.1.11",
    "@ai-sdk/openai": "^1.1.9",
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@projectflow/config": "workspace:*",
    "@projectflow/shared-types": "workspace:*",
    "@projectflow/validation": "workspace:*",
    "ai": "^4.1.27",
    "bullmq": "^5.40.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.5.0",
    "pg": "^8.13.2"
  },
  "devDependencies": {
    "@projectflow/eslint-config": "workspace:*",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.11.11",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
