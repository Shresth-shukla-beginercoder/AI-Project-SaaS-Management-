# Application
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 17 + pgvector)
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/projectflow_ai

# Authentication & JWT
# Generate secure random strings in production using: openssl rand -base64 32
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cache & Queues (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS Storage (Optional for local development)
AWS_REGION=us-east-1
AWS_S3_BUCKET=projectflow-ai-dev-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI Providers (Dependencies configured; supply keys when implementing)
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
