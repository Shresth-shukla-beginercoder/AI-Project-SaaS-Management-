# Monorepo Environment Variables Template
NODE_ENV=development

# Database (PostgreSQL 17 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=projectflow_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/projectflow_ai

# Cache & Message Broker (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application URLs
WEB_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1
WS_URL=http://localhost:5000

# Authentication & Security
# Generate secure keys: openssl rand -base64 32
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_key_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_key_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS S3 (Optional for local development)
AWS_REGION=us-east-1
AWS_S3_BUCKET=projectflow-ai-dev-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI Provider API Keys
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
