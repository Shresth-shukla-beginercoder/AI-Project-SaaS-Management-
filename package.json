{
  "name": "ai-project-management-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-grade AI-powered Project Management SaaS Monorepo",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@projectflow/web",
    "dev:api": "turbo run dev --filter=@projectflow/api",
    "dev:worker": "turbo run dev --filter=@projectflow/worker",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@projectflow/web",
    "build:api": "turbo run build --filter=@projectflow/api",
    "build:worker": "turbo run build --filter=@projectflow/worker",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter=@projectflow/api run db:generate",
    "db:migrate": "pnpm --filter=@projectflow/api run db:migrate",
    "db:studio": "pnpm --filter=@projectflow/api run db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  }
}
